# Copy this file to pe-claw.env.ps1 (which is Git-ignored) and replace every
# angle-bracket placeholder. Never commit the populated file.
$env:PE_CLAW_DATABASE_URL = 'postgresql+psycopg://pe_claw:<database-password>@127.0.0.1:5432/pe_claw'
$env:PE_CLAW_REDIS_URL = 'redis://:<redis-password>@127.0.0.1:6379/1'
$env:PE_CLAW_ARTIFACT_ROOT = 'C:\ProgramData\PE-Claw\artifacts'
$env:PE_CLAW_LEASE_SECONDS = '120'
$env:PE_CLAW_HEARTBEAT_SECONDS = '10'
$env:PE_CLAW_ARTIFACT_RETENTION_HOURS = '168'
